# Optional: only needed for Live model mode.
AI_SCROLL_API_KEY=
AI_SCROLL_BASE_URL=https://openrouter.ai/api/v1
AI_SCROLL_MODEL=
AI_SCROLL_INPUT_PRICE_PER_MILLION=0
AI_SCROLL_OUTPUT_PRICE_PER_MILLION=0

# Gmail OAuth (keep both JSON files out of Git)
AI_SCROLL_GOOGLE_CLIENT_SECRETS=data/private/google_client_secret.json
AI_SCROLL_GMAIL_TOKEN=data/private/gmail_token.json

# Microsoft OAuth for an Outlook / Microsoft 365 mailbox
AI_SCROLL_MICROSOFT_CLIENT_ID=
AI_SCROLL_MICROSOFT_TENANT_ID=common
AI_SCROLL_MICROSOFT_CONFIG=data/private/microsoft_oauth.json
AI_SCROLL_MICROSOFT_TOKEN=data/private/microsoft_token_cache.json
